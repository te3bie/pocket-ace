# Public client configuration only. Demo works without these.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Set server-only secrets with supabase secrets set, NEVER EXPO_PUBLIC_:
# AI_API_KEY, AI_API_URL, AI_MODEL (provider selection/billing requires owner approval)
# PLAID_CLIENT_ID, PLAID_SECRET, PLAID_WEBHOOK_URL, PLAID_REDIRECT_URI
# APP_ORIGIN (allowed web origin), BANK_TOKEN_KEY (32-byte base64 AES key)
